# Required: AssemblyAI API key (https://www.assemblyai.com/dashboard/api-keys).
# Claim hackathon credits via the signup link on the lablab event page first.
ASSEMBLYAI_API_KEY=

# Optional: Supabase, so the kitchen screen can be a different device and
# orders persist. Without these, the lane and kitchen sync between tabs of
# the same browser and orders live in server memory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional demo cost guards (defaults shown).
MAX_SESSION_SECONDS=180
SESSIONS_PER_IP_PER_HOUR=8
SESSIONS_PER_HOUR=120
# Set to true to pause the live demo (the rest of the site keeps working).
DEMO_PAUSED=false

# Optional: local testing from a phone on the same Wi-Fi
# DEV_LAN_HOST=192.168.1.20
# NEXT_PUBLIC_NOISE_URL=http://192.168.1.20:3100/noise
